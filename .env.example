# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nidoc

# Criptografia (32 bytes em base64)
CRYPTO_KEY=

# Sessões (segredo para HMAC)
SESSION_SECRET=

# Servidor
PORT=3000
NODE_ENV=development

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Armazenamento de PDFs
PDFS_DIR=./pdfs
