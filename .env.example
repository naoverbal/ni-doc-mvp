# Banco de dados
# DATABASE_URL: conexão do BACKEND em runtime. Use o papel de aplicação
#   `ni_doc_app` (SEM BYPASSRLS e sem ser owner/superusuário), para que o RLS
#   isole os tenants no banco (RF-002). A migration 004 cria esse papel.
DATABASE_URL=postgresql://ni_doc_app:ni_doc_app@localhost:5432/nidoc
# DATABASE_URL_ADMIN: conexão PRIVILEGIADA (owner/superusuário), usada SOMENTE
#   por `npm run migrate` e `npm run seed`. Nunca usada pelo servidor HTTP.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/nidoc

# Criptografia (32 bytes em base64)
CRYPTO_KEY=

# Sessões (segredo para HMAC)
SESSION_SECRET=

# Servidor
PORT=3000
NODE_ENV=development

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Armazenamento de PDFs
PDFS_DIR=./pdfs
